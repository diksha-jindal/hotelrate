# ──────────────────────────────────────────────
# hotelrate-mcp Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and adjust values.
# All settings have sensible defaults — only DEMO_MODE is
# typically changed for first-time MCP usage.

# ── Core ──────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO

# Set to true for synthetic demo data (no browser needed).
# Set to false for live Playwright crawls against real OTA sites.
DEMO_MODE=true

# ── Playwright (live mode only) ───────────────
HEADLESS=true
# Use `chrome` when you want users to complete login in a regular Chrome window.
# Keep `chromium` for the default Playwright-managed browser.
PLAYWRIGHT_BROWSER_CHANNEL=chromium
PLAYWRIGHT_DISABLE_AUTOMATION_FLAGS=true

# Per-platform browser profiles for session persistence.
# Leave empty to use ephemeral contexts.
PLAYWRIGHT_USER_DATA_DIR=
PLAYWRIGHT_USER_DATA_DIR_TRIP=.playwright/trip-profile
PLAYWRIGHT_USER_DATA_DIR_BOOKING=.playwright/booking-profile
PLAYWRIGHT_USER_DATA_DIR_AGODA=.playwright/agoda-profile
PLAYWRIGHT_USER_DATA_DIR_GOOGLE_HOTELS=

# ── Request Tuning ────────────────────────────
REQUEST_TIMEOUT_SECONDS=25
GOOGLE_REQUEST_TIMEOUT_SECONDS=90
PLATFORM_MAX_CONCURRENCY=2
PLATFORM_REQUEST_STAGGER_MS=250
BATCH_HOTEL_CONCURRENCY=3
BATCH_TASK_CONCURRENCY=6

# ── Defaults (used when MCP clients omit parameters) ──
DEFAULT_CHECKIN_OFFSET_DAYS=7
DEFAULT_LENGTH_OF_STAY=1
DEFAULT_ADULTS=2
DEFAULT_CHILDREN=0
DEFAULT_LOCALE=en-US

# Skip Google Hotels by default (slower and fragile).
GOOGLE_SKIP=true
TARGET_CITY=

# ── Firecrawl (optional URL discovery enhancer) ──
FIRECRAWL_BASE_URL=http://localhost:3002
FIRECRAWL_TIMEOUT_SECONDS=20
FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
FIRECRAWL_FALLBACK_FOR_LIVE_QUOTE=true

# ── URL Cache ─────────────────────────────────
URL_MAPPING_CACHE_PATH=reports/url_mapping_cache.json

# ── Database (worker/API mode only) ──────────
# Only needed if using the FastAPI or worker apps.
# DATABASE_URL=postgresql+asyncpg://hotelrate:hotelrate@localhost:5432/hotelrate
# CRAWL_INTERVAL_MINUTES=10
# CRAWL_CONCURRENCY=4

# ── Debug (set to true only for troubleshooting) ──
# GOOGLE_DEBUG_SAVE_HTML=false
# GOOGLE_DEBUG_SAVE_RUNTIME_ARTIFACTS=false
# BOOKING_DEBUG_SAVE_JSON=false
# AGODA_DEBUG_SAVE_JSON=false
# TRIP_DEBUG_SAVE_JSON=false
